<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>TollAppGroup</key>
	<string>$(TOLL_APP_GROUP)</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Only checks whether you are home. It never records where you go.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Starts your night when you get home and stops it when you leave, even with the app closed. It only checks whether you are home and never records where you go.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Dusk reads your sleep from Health to suggest your hours and show how your nights go. It never writes to Health or sends it anywhere.</string>
	<key>TollPrivacyURL</key>
	<string>$(TOLL_PRIVACY_URL)</string>
	<key>TollSupportEmail</key>
	<string>$(TOLL_SUPPORT_EMAIL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIWhitePointAdaptivityStyle</key>
	<string>UIWhitePointAdaptivityStyleReading</string>
</dict>
</plist>
