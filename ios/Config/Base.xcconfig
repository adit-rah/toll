// Identity and endpoints live here so a rename or a new domain is one edit.
TOLL_BUNDLE_ID = com.advan.toll
TOLL_APP_GROUP = group.com.advan.toll
TOLL_LINK_HOST = toll.alders.dev
TOLL_API_BASE_URL = https:/$()/toll.alders.dev/v1

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Committed because Xcode Cloud signs from committed files only; the team id is in every signed build anyway.
// A git-ignored Signing.xcconfig can override it to sign with another team locally.
DEVELOPMENT_TEAM = JAFS73RCH8
#include? "Signing.xcconfig"

// Observability (spec §12, §16). Empty turns each off.
TOLL_SENTRY_DSN =
TOLL_TELEMETRYDECK_APP_ID =

// Settings → Support Toll. Empty hides the row (ledger B: no donation link yet).
TOLL_DONATION_URL =
