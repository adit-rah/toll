{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toll-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://toll.alders.dev",
    "APPLE_BUNDLE_ID": "com.advan.toll",
    "APPLE_TEAM_ID": "",
    "APPLE_KEY_ID": "",
    "APNS_KEY_ID": "",
    "APNS_HOST": "api.push.apple.com",
    "EMAIL_FROM": "Toll <code@toll.alders.dev>",
    "FOUNDERS_EMAIL": "support@toll.alders.dev",
    "SENTRY_DSN": "",
    "APP_STORE_URL": "",
    "REVIEW_EMAIL": "review@toll.alders.dev"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "toll", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
  "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "toll" }],
  "queues": {
    "producers": [{ "binding": "PUSH_QUEUE", "queue": "toll-push" }],
    "consumers": [{ "queue": "toll-push", "max_batch_size": 100, "max_concurrency": 6 }]
  },
  "ratelimits": [
    { "name": "RL_OTP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_SOCIAL", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_INGEST", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "triggers": { "crons": ["0 * * * *", "30 9 * * *", "0 11 * * 1"] },
  "env": {
    "preview": {
      "name": "toll-api-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "PUBLIC_BASE_URL": "https://toll-api-preview.workers.dev",
        "APPLE_BUNDLE_ID": "com.advan.toll",
        "APPLE_TEAM_ID": "",
        "APPLE_KEY_ID": "",
        "APNS_KEY_ID": "",
        "APNS_HOST": "api.sandbox.push.apple.com",
        "EMAIL_FROM": "Toll <code@toll.alders.dev>",
        "FOUNDERS_EMAIL": "support@toll.alders.dev",
        "SENTRY_DSN": "",
        "APP_STORE_URL": "",
        "REVIEW_EMAIL": "review@toll.alders.dev"
      },
      "d1_databases": [
        { "binding": "DB", "database_name": "toll-preview", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "kv_namespaces": [{ "binding": "CONFIG", "id": "00000000000000000000000000000000" }],
      "r2_buckets": [{ "binding": "STORAGE", "bucket_name": "toll-preview" }],
      "queues": {
        "producers": [{ "binding": "PUSH_QUEUE", "queue": "toll-push-preview" }],
        "consumers": [{ "queue": "toll-push-preview", "max_batch_size": 100, "max_concurrency": 6 }]
      },
      "ratelimits": [
        { "name": "RL_OTP", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_SOCIAL", "namespace_id": "2002", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_INGEST", "namespace_id": "2003", "simple": { "limit": 60, "period": 60 } }
      ],
      "triggers": { "crons": ["0 * * * *", "30 9 * * *", "0 11 * * 1"] }
    }
  }
}
